# Copy to .env. Never commit the real file.
# Optional: switch to public.ecr.aws/docker/library when Docker Hub is unreachable.
BASE_IMAGE_REGISTRY=docker.io/library
# Keep the default official npm registry; override only with an organization-approved mirror.
NPM_REGISTRY=https://registry.npmjs.org
# Used only by docker-compose.distributed.yml; keep server/client on the same minor series.
QDRANT_IMAGE=qdrant/qdrant:v1.18.3
WEB_PORT=8080
ENVIRONMENT=production
SECRET_KEY=replace-with-at-least-32-random-characters-before-start
# Prefer an independent random secret in production. If omitted, the backend
# derives a domain-separated encryption key from SECRET_KEY.
CREDENTIAL_ENCRYPTION_KEY=
# Only administrators can configure provider URLs, and the backend still
# restricts outbound credential-bearing requests to this allowlist.
PROVIDER_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,openrouter.ai,dashscope.aliyuncs.com,dashscope-intl.aliyuncs.com,dashscope-us.aliyuncs.com,.maas.aliyuncs.com,localhost,127.0.0.1,host.docker.internal,vllm-stable,vllm-canary,ollama
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password

MYSQL_DATABASE=aegis
MYSQL_USER=aegis
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
DATABASE_URL=mysql+pymysql://aegis:replace-with-a-strong-database-password@mysql:3306/aegis?charset=utf8mb4

AUTO_CREATE_TABLES=false
AUTO_SEED=true
INGESTION_MODE=inline
INGESTION_POLL_SECONDS=1
INGESTION_LEASE_SECONDS=300
ALLOWED_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,backend
BUSINESS_TIMEZONE=Asia/Hong_Kong
DAILY_QUESTION_LIMIT=100
QUESTION_MAX_CHARS=500
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
MAX_UPLOAD_MB=15
MAX_INFLIGHT_REQUESTS=200

# Safe offline demo: deterministic local embedding + extractive mock generator.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=local_hash
MULTIMODAL_PROVIDER=disabled

# Real OpenAI-compatible service (OpenAI, compatible gateway, or Ollama):
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_OUTPUT_TOKENS=800
# Independent model / Embedding / Prompt / RAG / vLLM service canaries. Keep every value at 0
# until offline replay, shadow validation, and the admin kill-switch drill pass.
EXPERIMENT_SALT=replace-with-a-long-random-routing-secret
# Comma-separated IDs. Blacklists take precedence over whitelists; sensitive
# intents then force Stable before percentage routing is considered.
EXPERIMENT_WHITELIST_TENANT_IDS=
EXPERIMENT_WHITELIST_USER_IDS=
EXPERIMENT_WHITELIST_CONVERSATION_IDS=
EXPERIMENT_BLACKLIST_TENANT_IDS=
EXPERIMENT_BLACKLIST_USER_IDS=
EXPERIMENT_BLACKLIST_CONVERSATION_IDS=
MODEL_CANARY_PERCENT=0
EMBEDDING_CANARY_PERCENT=0
PROMPT_CANARY_PERCENT=0
RAG_CANARY_PERCENT=0
SERVICE_CANARY_PERCENT=0
SHADOW_CANARY_PERCENT=0
SHADOW_TIMEOUT_SECONDS=60
EXPERIMENT_STABLE_INTENTS=投诉,售后问题
PROMPT_STABLE_VERSION=customer_v1
PROMPT_CANARY_VERSION=customer_v2
# LLM_CANARY_BASE_URL=http://vllm-canary:8000/v1
# LLM_CANARY_API_KEY=
# LLM_CANARY_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-canary
LLM_SERVICE_STABLE_VERSION=vllm-stable
LLM_SERVICE_CANARY_VERSION=vllm-canary
CANARY_ROLLBACK_WINDOW_SECONDS=300
CANARY_ROLLBACK_MIN_SAMPLES=20
CANARY_ROLLBACK_ERROR_RATE=0.10
CANARY_ROLLBACK_TIMEOUT_RATE=0.05
CANARY_ROLLBACK_TOOL_FAILURE_RATE=0.05
CANARY_ROLLBACK_TTFT_P95_MS=4000
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=384
# EMBEDDING_SEND_DIMENSIONS=true
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-replace-me
# EMBEDDING_TIMEOUT_SECONDS=20
# EMBEDDING_MAX_RETRIES=2
# Some providers (including DashScope) accept at most 10 texts per request.
# EMBEDDING_BATCH_SIZE=10
# EMBEDDING_MAX_CONCURRENCY=64
# EMBEDDING_QUEUE_TIMEOUT_SECONDS=2
# EMBEDDING_QUERY_CACHE_SIZE=512
# EMBEDDING_QUERY_CACHE_TTL_SECONDS=300
# Stable and canary embedding models must use different physical collections.
# EMBEDDING_STABLE_VERSION=text-embedding-v4-512-v1
# EMBEDDING_CANARY_MODEL=qwen3.7-text-embedding
# EMBEDDING_CANARY_DIMENSIONS=512
# EMBEDDING_CANARY_SEND_DIMENSIONS=true
# EMBEDDING_CANARY_BASE_URL=
# EMBEDDING_CANARY_API_KEY=
# EMBEDDING_CANARY_BATCH_SIZE=10
# EMBEDDING_CANARY_VERSION=qwen3.7-text-embedding-512-v1
# MULTIMODAL_PROVIDER=openai_compatible
# VISION_MODEL=gpt-4o-mini
# Optional one-time import into the encrypted administrator credential store.
# DASHSCOPE_API_KEY=sk-ws-...
# DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Set true only when this ignored environment key was validated out-of-band.
# Normal administrator-console updates always validate before enabling.
DASHSCOPE_BOOTSTRAP_VALIDATED=false

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=aegis_knowledge_chunks_schema4
# QDRANT_CANARY_COLLECTION=aegis_knowledge_chunks_canary_schema4

RETRIEVAL_TOP_K=12
RETRIEVAL_FINAL_K=6
RETRIEVAL_MAX_DISTANCE=0.68
RETRIEVAL_MIN_LEXICAL_SCORE=0.08
RETRIEVAL_CRITICAL_MARGIN=0.10
# Stable RAG strategy parameters. The expansion value is one total budget
# shared by all expansion query channels, not a multiplier for each channel.
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_SPARSE_WEIGHT=1.0
RETRIEVAL_EXPANSION_WEIGHT=0.75
RAG_STABLE_VERSION=hybrid_rrf_v2
RAG_CANARY_VERSION=multi_rrf_v3
RAG_CANARY_TOP_K=20
RAG_CANARY_FINAL_K=6
RAG_CANARY_RRF_K=60
RAG_CANARY_DENSE_WEIGHT=1.0
RAG_CANARY_SPARSE_WEIGHT=1.0
RAG_CANARY_EXPANSION_WEIGHT=0.75
RAG_CANARY_CANDIDATE_K=20
RAG_CANARY_RERANK_POLICY=always
RAG_CANARY_RERANK_WEIGHT=0.70
RAG_CANARY_CONTEXT_CHARS=12000
# Optional quality layer: only ambiguous/compound queries call the OpenAI-compatible reranker.
# It shares the configured endpoint/model by default and always fails back to deterministic ranking.
RERANKER_ENABLED=false
RERANKER_PROVIDER=llm_json
RERANKER_MODEL=
RERANKER_CANDIDATE_K=10
RERANKER_MIN_CANDIDATES=4
RERANKER_WEIGHT=0.55
RERANKER_AMBIGUITY_MARGIN=0.08
RERANKER_TIMEOUT_SECONDS=10
RERANKER_MAX_CONCURRENCY=8
RERANKER_QUEUE_TIMEOUT_SECONDS=1.5
MAX_CONTEXT_CHARS=12000
MAX_HISTORY_CHARS=6000
HISTORY_TURNS=6
CHAT_TURN_LEASE_SECONDS=300
